{
  "name": "@mbork_pl/skill-shed",
  "version": "0.1.0",
  "description": "A set of tools for managing agent skills",
  "keywords": [
    "skills",
    "agentic",
    "coding",
    "deployment",
    "linting"
  ],
  "homepage": "https://github.com/mbork/skill-shed#readme",
  "bugs": {
    "url": "https://github.com/mbork/skill-shed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbork/skill-shed.git"
  },
  "license": "GPL-3.0",
  "author": "Marcin Borkowski",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "files": [
    "src",
    "assets",
    "README.org"
  ],
  "bin": {
    "skill-shed": "src/skill-shed.ts"
  },
  "scripts": {
    "postinstall": "patch-package",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "tsgo --noEmit",
    "coverage": "npx c8 node --test --test-reporter=dot",
    "coverage-report": "npx c8 --reporter=html node --test --test-reporter=dot && xdg-open coverage/index.html"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "24.12.0",
    "@typescript/native-preview": "7.0.0-dev.20260324.1",
    "c8": "^11.0.0",
    "eslint": "10.1.0",
    "jiti": "2.6.1",
    "patch-package": "^8.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2"
  },
  "dependencies": {
    "leven": "4.1.0",
    "yaml": "2.8.3"
  }
}
